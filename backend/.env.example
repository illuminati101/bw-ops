APP_NAME="Black & White Ops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local testing uses SQLite. On XAMPP switch to mysql (see SETUP-WINDOWS.md).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bwops
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Real-time (live map, dispatch offers, chat)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=bwops
REVERB_APP_KEY=bwops-key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Email. "log" writes emails to storage/logs instead of sending them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail.blackandwhiteops.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="bookings@blackandwhiteops.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Black & White Ops integrations (leave blank to use the built-in stand-ins) ---
# SMS + voice: "log" shows codes in Admin > Message log; "twilio" sends for real.
BW_SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Card payments: blank = record-only mode (no real charges).
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Maps: blank = OpenStreetMap fallback for maps and address search.
GOOGLE_MAPS_API_KEY=

# Push notifications via Expo (optional)
EXPO_ACCESS_TOKEN=

# Public URL the mobile apps should use for websockets (defaults to REVERB_HOST)
BW_PUBLIC_WS_HOST=
BW_PUBLIC_WS_PORT=
BW_PUBLIC_WS_SCHEME=

# Use APP_URL for every generated link (needed behind a tunnel or proxy that rewrites the host)
BW_FORCE_APP_URL=false
# Two-factor sign-in for the admin panel is required in production; set true to require it elsewhere too
# ADMIN_REQUIRE_MFA=true
# Map tiles for the website and apps (OpenStreetMap by default; use a commercial provider at scale)
BW_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
